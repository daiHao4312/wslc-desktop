<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslcDesktop.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StatCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页面标题 -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="概览" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="wslc 容器运行时状态、会话存储与核心指标" />
            </StackPanel>

            <!-- 错误横幅 -->
            <InfoBar
                x:Name="ErrorInfoBar"
                Grid.Row="1"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <!-- 统计卡片栅格：3 列 × 2 行 -->
            <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="运行中容器" />
                        <TextBlock x:Name="RunningContainersText" FontSize="28" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="全部容器" />
                        <TextBlock x:Name="TotalContainersText" FontSize="28" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StatCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本地镜像" />
                        <TextBlock x:Name="TotalImagesText" FontSize="28" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="网络" />
                        <TextBlock x:Name="TotalNetworksText" FontSize="28" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="数据卷" />
                        <TextBlock x:Name="TotalVolumesText" FontSize="28" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource StatCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="活动会话" />
                        <TextBlock x:Name="ActiveSessionsText" FontSize="28" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 运行时信息 + 存储占用 -->
            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="运行时与引擎信息" />
                        <Grid ColumnSpacing="24" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WSL 引擎版本：" />
                            <TextBlock x:Name="WslVersionText" Grid.Row="0" Grid.Column="1" Text="检测中…" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Linux 内核版本：" />
                            <TextBlock x:Name="KernelVersionText" Grid.Row="1" Grid.Column="1" Text="检测中…" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="会话管理器版本：" />
                            <TextBlock x:Name="SessionManagerVersionText" Grid.Row="2" Grid.Column="1" Text="检测中…" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Windows 系统版本：" />
                            <TextBlock x:Name="WindowsVersionText" Grid.Row="3" Grid.Column="1" Text="检测中…" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="引擎配置文件：" />
                            <TextBlock
                                x:Name="SettingsFileText"
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="检测中…"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="会话存储占用" />
                        <TextBlock
                            x:Name="TotalStorageText"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="—" />
                        <TextBlock
                            x:Name="SessionsRootText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="—"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="每个会话拥有独立的虚拟磁盘，会话之间的容器与镜像互不可见。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 会话列表 -->
            <Border Grid.Row="4" Style="{StaticResource SectionCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="活动会话" />

                    <ListView
                        x:Name="SessionsListView"
                        MaxHeight="260"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionModel">
                                <Grid Padding="4,8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind StoragePathDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Id}" />

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind VhdSizeDisplay}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind TotalSizeDisplay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="SessionsEmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="当前没有活动会话。启动任意容器后会自动创建会话。"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

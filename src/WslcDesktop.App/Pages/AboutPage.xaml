<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="关于" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="项目信息、版本更新与环境自检" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <!-- 用 256 的 PNG，不要用 AppIcon.ico：XAML 解码 ICO 只会取其中
                             一个小尺寸帧（16/32）再拉到 56px，边缘糊得厉害 -->
                        <Image Width="56" Height="56" Source="/Assets/AppIcon-256.png" />
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock FontSize="20" FontWeight="Bold" Text="wslc-desktop" />
                            <!-- 版本号由 AppInfo 从程序集读取，不要在 XAML 里写死 -->
                            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        TextWrapping="Wrap"
                        Text="为 WSL 容器（wslc）打造的原生桌面管理面板。轻量、快速、无额外运行时层，支持 Mica 材质与深浅色模式即时切换。" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="遵循 Apache-2.0 协议 · 数据层经验参考开源项目 wslc-panel，官方 API 契约与控件实现参考 WSL Container Desktop" />
                </StackPanel>
            </Border>

            <!-- 版本与更新（M12） -->
            <Border
                Grid.Row="2"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="版本与更新" />

                    <Grid ColumnSpacing="24" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前版本：" />
                        <TextBlock x:Name="CurrentVersionText" Grid.Row="0" Grid.Column="1" Text="—" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="更新源：" />
                        <TextBlock
                            x:Name="UpdateSourceText"
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="—"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="上次检查：" />
                        <TextBlock x:Name="LastCheckText" Grid.Row="2" Grid.Column="1" Text="从未检查" />
                    </Grid>

                    <InfoBar
                        x:Name="UpdateInfoBar"
                        IsClosable="True"
                        IsOpen="False" />

                    <!-- 下载进度：只在下载期间显示，不占常驻高度 -->
                    <StackPanel x:Name="UpdateProgressPanel" Spacing="6" Visibility="Collapsed">
                        <ProgressBar x:Name="UpdateProgressBar" Maximum="100" Minimum="0" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="UpdateProgressText"
                                Grid.Column="0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="准备下载…"
                                TextTrimming="CharacterEllipsis" />
                            <Button x:Name="CancelUpdateButton" Grid.Column="1" Click="CancelUpdate_Click" Content="取消" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE895;" />
                                <TextBlock Text="检查更新" />
                            </StackPanel>
                        </Button>

                        <!-- 在线更新：有新版才出现的两个按钮，下载完把"下载"换成"安装" -->
                        <Button
                            x:Name="DownloadUpdateButton"
                            Click="DownloadAndUpdate_Click"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                <TextBlock x:Name="DownloadUpdateButtonText" Text="下载并更新" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="InstallUpdateButton"
                            Click="InstallUpdate_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE777;" />
                                <TextBlock Text="重启并安装" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="OpenDownloadPageButton" Click="OpenDownloadPage_Click" Content="打开下载页" Visibility="Collapsed" />

                        <Button Click="CopyVersionInfo_Click" Content="复制版本信息" />
                    </StackPanel>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="更新检查与下载都会访问 GitHub，不上传任何本机数据；下载完成后由你决定何时替换并重启。替换只动程序自己那个 exe，旧版本会保留为同目录下的 .old 备份。" />
                </StackPanel>
            </Border>

            <!-- 环境自检 -->
            <Border
                Grid.Row="3"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="环境自检" />

                    <InfoBar
                        x:Name="ReadinessInfoBar"
                        IsClosable="False"
                        IsOpen="False" />

                    <Grid ColumnSpacing="24" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WSL 引擎：" />
                        <TextBlock x:Name="EngineVersionText" Grid.Row="0" Grid.Column="1" Text="检测中…" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Linux 内核：" />
                        <TextBlock x:Name="KernelText" Grid.Row="1" Grid.Column="1" Text="检测中…" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="会话管理器：" />
                        <TextBlock x:Name="SessionManagerText" Grid.Row="2" Grid.Column="1" Text="检测中…" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Windows：" />
                        <TextBlock x:Name="WindowsText" Grid.Row="3" Grid.Column="1" Text="检测中…" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="缺失组件：" />
                        <TextBlock x:Name="MissingComponentsText" Grid.Row="4" Grid.Column="1" Text="检测中…" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="引擎配置：" />
                        <TextBlock
                            x:Name="SettingsFileText"
                            Grid.Row="5"
                            Grid.Column="1"
                            Text="检测中…"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 只在检测到缺失组件时出现：组件齐全时它没有意义 -->
                        <Button
                            x:Name="RepairComponentsButton"
                            Click="RepairComponents_Click"
                            Content="一键安装/修复"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed" />
                        <Button Click="CopyUpgradeCommand_Click" Content="复制升级命令" />
                        <Button Click="OpenWslcPrompt_Click" Content="在终端中使用 wslc" />
                        <Button Click="RefreshCheck_Click" Content="重新检测" />
                    </StackPanel>

                    <StackPanel
                        x:Name="RepairProgressPanel"
                        Spacing="6"
                        Visibility="Collapsed">
                        <ProgressBar x:Name="RepairProgressBar" IsIndeterminate="True" />
                        <TextBlock
                            x:Name="RepairStatusText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="已知边界：官方 wslc compose 尚未发布，本面板不自研编排层；交互式终端与日志跟随交由 Windows Terminal；渲染与真实交互需在本机实测。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--
                诊断（M20）：包里只放版本、状态与计数，不放容器环境变量与任何凭据。
                prefs.json 会先脱敏（按字段名删除 password/token/secret/credential 类条目）。
            -->
            <Border
                Grid.Row="4"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="诊断" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="导出一个 zip：面板/引擎/会话版本、缺失组件、API 通道探测结果、容器与镜像计数，以及 error.log 末尾 300 行。包内不含容器环境变量与任何凭据（prefs.json 会先脱敏）。"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ExportDiagnosticsButton"
                            Click="ExportDiagnostics_Click"
                            Content="导出诊断包" />
                        <Button
                            x:Name="RevealDiagnosticsButton"
                            Click="RevealDiagnostics_Click"
                            Content="打开所在文件夹"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <InfoBar
                        x:Name="DiagnosticsInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Success" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

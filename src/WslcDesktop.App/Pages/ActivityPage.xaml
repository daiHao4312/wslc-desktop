<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslcDesktop.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 工具条 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="活动" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="引擎事件的实时流水（新增在最上）" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Top">
                <ComboBox
                    x:Name="TypeFilterComboBox"
                    MinWidth="140"
                    SelectionChanged="TypeFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="全部类别" Tag="*" />
                    <ComboBoxItem Content="容器" Tag="container" />
                    <ComboBoxItem Content="网络" Tag="network" />
                    <ComboBoxItem Content="数据卷" Tag="volume" />
                    <ComboBoxItem Content="镜像" Tag="image" />
                </ComboBox>

                <ToggleButton
                    x:Name="PauseToggle"
                    ToolTipService.ToolTip="暂停后新事件仍会记录，只是不往列表里加"
                    Checked="PauseToggle_Changed"
                    Unchecked="PauseToggle_Changed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE769;" />
                        <TextBlock Text="暂停" />
                    </StackPanel>
                </ToggleButton>

                <Button Click="Clear_Click" ToolTipService.ToolTip="清空缓冲（不影响引擎）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="清空" />
                    </StackPanel>
                </Button>

                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 订阅状态：连接状态必须一直可见，否则用户会误以为面板还在实时同步 -->
        <Border
            Grid.Row="1"
            Padding="12,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse
                        x:Name="StreamStateDot"
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                    <TextBlock x:Name="StreamStateText" FontSize="12" Text="事件流未启动" />
                </StackPanel>

                <TextBlock
                    x:Name="StreamDetailText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    x:Name="CountText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <InfoBar
            x:Name="HintInfoBar"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE81C;" />
            <TextBlock
                x:Name="EmptyStateText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="还没有事件。启动或停止一个容器试试。"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            x:Name="EventsListView"
            Grid.Row="3"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:WslcEvent">
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind TimeDisplay}" />

                        <Ellipse
                            Grid.Column="1"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{x:Bind Severity, Converter={StaticResource EventSeverityBrushConverter}}" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind Summary}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Summary}" />

                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ActorShortId}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

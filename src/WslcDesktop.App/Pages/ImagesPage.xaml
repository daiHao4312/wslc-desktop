<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslcDesktop.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题与操作栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="镜像" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本地 WSL 容器镜像与拉取管理" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="PullButton_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE896;" />
                        <TextBlock Text="拉取镜像" />
                    </StackPanel>
                </Button>
                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 拉取进度：就地更新，不弹窗打扰（§7.3-3） -->
        <Border
            x:Name="PullPanel"
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PullTitleText"
                        FontWeight="Medium"
                        Text="正在拉取镜像"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="CancelPullButton"
                        Grid.Column="1"
                        Padding="8,2"
                        Click="CancelPull_Click"
                        Content="取消拉取" />
                </Grid>

                <ProgressBar x:Name="PullBar" IsIndeterminate="True" />

                <TextBlock
                    x:Name="PullStatusText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="正在连接镜像源…"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="2"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <!-- 空态 -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xEB9F;" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本地还没有镜像。点右上角「拉取镜像」开始。" />
        </StackPanel>

        <!-- 镜像列表 -->
        <ListView
            x:Name="ImagesListView"
            Grid.Row="2"
            Margin="0,20,0,0"
            Padding="0,0,0,64"
            IsMultiSelectCheckBoxEnabled="False"
            ItemContainerStyle="{StaticResource DataRowItemStyle}"
            SelectionChanged="ImagesListView_SelectionChanged"
            SelectionMode="Multiple">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <!--
                        表头与行是两套**独立测量**的 Grid：只有列定义完全相同才会对齐。
                        首列（图标）与末列（操作）原先是 Auto——表头里没有等宽内容，
                        两侧各测各的会让后面所有列整体错位，所以一并钉成固定宽度。
                    -->
                    <Grid Padding="44,0,12,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="镜像 / 仓库" />
                        <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ID / 创建时间" />
                        <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="大小" />
                        <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="操作" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ImageModel">
                    <Grid Padding="44,10,12,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>

                        <!--
                            紧凑勾选框。ListViewItemPresenter 必须是行模板的根元素本身，
                            没法在行容器模板里换掉那个尺寸写死的大号多选框，所以只能放在这里；
                            -30 的左外边距是把勾选框挪进根 Grid 的 44px 左内边距里（44 - 30 = 14）。
                        -->
                        <CheckBox
                            x:Name="RowCheckBox"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Margin="-30,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="RowCheckBox_Click"
                            Loaded="RowCheckBox_Loaded"
                            Style="{StaticResource CompactCheckBoxStyle}" />

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xEB9F;" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind FullName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Repository}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Id}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind CreatedAtRaw}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Size}" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                            <Button
                                Click="CreateFromImage_Click"
                                Tag="{x:Bind FullName}"
                                ToolTipService.ToolTip="用此镜像创建容器">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                            <Button
                                Click="RenameImage_Click"
                                Tag="{x:Bind FullName}"
                                ToolTipService.ToolTip="改标签 / 重命名（同一个镜像可以挂多个名字）">
                                <FontIcon FontSize="12" Glyph="&#xE8AC;" />
                            </Button>
                            <Button
                                Click="Delete_Click"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="删除镜像">
                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            批量操作条：必须声明在 ListView 之后（后声明的孩子既画在上面、也先拿到点击）。
            放在前面时 ListView 会盖住它，把按钮点击全部吃掉——批量条看得见却点不动。
        -->
        <Border
            x:Name="BatchBar"
            Grid.Row="2"
            Height="48"
            Margin="0,0,0,12"
            Padding="16,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Translation="0,0,32"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="BatchSelectionText"
                    VerticalAlignment="Center"
                    FontWeight="Medium"
                    Text="已选 0 项" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="BatchClearSelection_Click">
                        <TextBlock Text="取消选择" />
                    </Button>
                    <Button Click="BatchDelete_Click" ToolTipService.ToolTip="删除所有选中镜像（不可撤销）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE74D;" />
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="删除" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

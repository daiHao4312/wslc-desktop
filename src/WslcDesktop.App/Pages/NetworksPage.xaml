<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.NetworksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslcDesktop.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="网络" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="wslc 容器网络与驱动管理（bridge / host / none 为内置网络，不可删除）" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="CreateNetwork_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="新建网络" />
                    </StackPanel>
                </Button>
                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="2"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE774;" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前会话中没有网络。" />
        </StackPanel>

        <ListView
            x:Name="NetworksListView"
            Grid.Row="2"
            Padding="0,0,0,64"
            IsMultiSelectCheckBoxEnabled="False"
            ItemContainerStyle="{StaticResource DataRowItemStyle}"
            SelectionChanged="NetworksListView_SelectionChanged"
            SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:NetworkModel">
                    <Grid Padding="44,10,12,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            紧凑勾选框。ListViewItemPresenter 必须是行模板的根元素本身，
                            没法在行容器模板里换掉那个尺寸写死的大号多选框，所以只能放在这里；
                            -30 的左外边距是把勾选框挪进根 Grid 的 44px 左内边距里（44 - 30 = 14）。
                        -->
                        <CheckBox
                            x:Name="RowCheckBox"
                            Grid.Column="0"
                            Grid.ColumnSpan="6"
                            Margin="-30,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="RowCheckBox_Click"
                            Loaded="RowCheckBox_Loaded"
                            Style="{StaticResource CompactCheckBoxStyle}" />

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE774;" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Id}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Driver}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Scope}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind IpSupportDisplay}" />

                        <Button
                            Grid.Column="5"
                            Click="RemoveNetwork_Click"
                            IsEnabled="{x:Bind IsRemovable}"
                            Tag="{x:Bind Name}"
                            ToolTipService.ToolTip="{x:Bind RemoveHint}">
                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            批量操作条：必须声明在 ListView 之后（后声明的孩子既画在上面、也先拿到点击）。
            放在前面时 ListView 会盖住它，把按钮点击全部吃掉——批量条看得见却点不动。
        -->
        <Border
            x:Name="BatchBar"
            Grid.Row="2"
            Height="48"
            Margin="0,0,0,12"
            Padding="16,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Translation="0,0,32"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="BatchSelectionText"
                    VerticalAlignment="Center"
                    FontWeight="Medium"
                    Text="已选 0 项" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="BatchClearSelection_Click">
                        <TextBlock Text="取消选择" />
                    </Button>
                    <Button Click="BatchDelete_Click" ToolTipService.ToolTip="删除所有选中网络（内置网络会自动跳过）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE74D;" />
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="删除" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.CreateContainerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题与提交 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Top"
                Click="Back_Click"
                ToolTipService.ToolTip="返回容器列表">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="新建容器" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="填写参数后创建；右侧实时显示等效的 wslc run 命令" />
            </StackPanel>

            <!--
                页头只留一个主操作。
                「复制命令」原先在这里也有一个，与右侧「等效命令预览」卡片右上角的
                「复制」按钮完全重复（同一个 CopyCommand_Click）——命令在哪个卡片里，
                复制入口就放哪儿，所以删掉页头这个，避免两处入口互相抢注意力。
            -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CreateButton" Click="Create_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="创建并启动" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="MessageInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 表单 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="Medium" Text="镜像与身份" />

                            <ComboBox
                                x:Name="ImageCombo"
                                HorizontalAlignment="Stretch"
                                Header="镜像"
                                IsEditable="True"
                                PlaceholderText="例如 nginx:latest 或 docker.1panel.live/library/mysql:latest"
                                TextSubmitted="ImageCombo_TextSubmitted" />

                            <TextBlock
                                x:Name="ImageHintText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="选择或输入镜像后可自动读取其声明的端口与启动命令。"
                                TextWrapping="Wrap" />

                            <TextBox x:Name="NameBox" Header="容器名称（可选）" PlaceholderText="例如 my-nginx" TextChanged="Field_Changed" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBox x:Name="MemoryBox" Width="160" Header="内存限制" PlaceholderText="512M" TextChanged="Field_Changed" />
                                <TextBox x:Name="CpusBox" Width="160" Header="CPU 数" PlaceholderText="0.5" TextChanged="Field_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="Medium" Text="端口、环境与存储" />

                            <TextBox
                                x:Name="PortsBox"
                                AcceptsReturn="True"
                                Header="端口映射（每行一条：主机端口:容器端口）"
                                PlaceholderText="8080:80"
                                TextChanged="Field_Changed" />

                            <TextBox
                                x:Name="EnvBox"
                                AcceptsReturn="True"
                                Header="环境变量（每行一条 KEY=VALUE）"
                                PlaceholderText="MYSQL_ROOT_PASSWORD=secret"
                                TextChanged="Field_Changed" />

                            <TextBox
                                x:Name="VolumesBox"
                                AcceptsReturn="True"
                                Header="卷挂载（每行一条：卷名或主机目录:容器路径）"
                                PlaceholderText="mysql-data:/var/lib/mysql"
                                TextChanged="Field_Changed" />

                            <ComboBox
                                x:Name="NetworkCombo"
                                HorizontalAlignment="Stretch"
                                Header="网络"
                                IsEditable="True"
                                PlaceholderText="bridge"
                                TextSubmitted="Field_ComboChanged" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="Medium" Text="高级" />

                            <TextBox x:Name="CommandBox" Header="覆盖启动命令（可选）" PlaceholderText="例如 nginx -g 'daemon off;'" TextChanged="Field_Changed" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBox x:Name="WorkdirBox" Width="200" Header="工作目录" PlaceholderText="/app" TextChanged="Field_Changed" />
                                <TextBox x:Name="HostnameBox" Width="200" Header="主机名" PlaceholderText="myhost" TextChanged="Field_Changed" />
                            </StackPanel>

                            <ComboBox x:Name="PullPolicyCombo" Width="220" Header="镜像拉取策略" SelectionChanged="Field_ComboChanged">
                                <ComboBoxItem Content="本地缺失时拉取（默认）" Tag="missing" />
                                <ComboBoxItem Content="总是拉取" Tag="always" />
                                <ComboBoxItem Content="从不拉取" Tag="never" />
                            </ComboBox>

                            <ToggleSwitch x:Name="RemoveOnExitToggle" Header="容器停止后自动删除（--rm）" Toggled="Field_Toggled" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--
                等效命令预览。
                高度必须**随内容自适应**：Border 默认 VerticalAlignment=Stretch，配合原先
                命令区所在的 * 行，会让卡片在只有一行命令时也撑满右侧全高——这就是
                "占了一半"的根因。改成 Top 对齐 + 命令区 MaxHeight 上限后，
                短命令只占几行，长命令最多到上限再滚动。
            -->
            <Border
                Grid.Column="1"
                Padding="14,12"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Text="等效命令预览" />
                        <Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CopyCommand_Click"
                            ToolTipService.ToolTip="复制该命令">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                <TextBlock FontSize="12" Text="复制" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--
                        水平滚动条必须 Disabled：ScrollViewer 一旦在水平方向给内容无限约束，
                        TextWrapping="Wrap" 就永远不换行，命令会变成一条超宽单行被裁掉
                        （实测：269 字符的命令文本高度只有 14px，即单行）。
                        关掉水平滚动后 Wrap 才真正生效，命令完整换行显示，高度仍受 MaxHeight 约束。
                    -->
                    <ScrollViewer
                        MaxHeight="200"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="CommandPreviewText"
                            FontFamily="Consolas"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </ScrollViewer>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="与面板实际执行的是同一份拼装逻辑，可直接复制到终端排错。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.VolumesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslcDesktop.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="数据卷" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="命名卷与持久化存储挂载（匿名卷由容器自动创建）" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="CreateVolume_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="新建命名卷" />
                    </StackPanel>
                </Button>
                <Button Click="PruneVolumes_Click" ToolTipService.ToolTip="清理未被任何容器使用的卷">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="清理未使用" />
                    </StackPanel>
                </Button>
                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="2"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xEDA2;" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前会话中没有任何卷。创建容器时用「卷挂载」即可生成。" />
        </StackPanel>

        <ListView
            x:Name="VolumesListView"
            Grid.Row="2"
            Padding="0,0,0,64"
            IsMultiSelectCheckBoxEnabled="False"
            ItemContainerStyle="{StaticResource DataRowItemStyle}"
            SelectionChanged="VolumesListView_SelectionChanged"
            SelectionMode="Multiple">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <!-- 表头与行两套 Grid 必须同列定义；Auto 列一律钉成固定宽度，见 ImagesPage 的说明 -->
                    <Grid Padding="44,0,12,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="名称 / 挂载点" />
                        <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="标签" />
                        <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="驱动" />
                        <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="大小" />
                        <TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="操作" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:VolumeModel">
                    <Grid Padding="44,10,12,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <!--
                            紧凑勾选框。ListViewItemPresenter 必须是行模板的根元素本身，
                            没法在行容器模板里换掉那个尺寸写死的大号多选框，所以只能放在这里；
                            -30 的左外边距是把勾选框挪进根 Grid 的 44px 左内边距里（44 - 30 = 14）。
                        -->
                        <CheckBox
                            x:Name="RowCheckBox"
                            Grid.Column="0"
                            Grid.ColumnSpan="6"
                            Margin="-30,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="RowCheckBox_Click"
                            Loaded="RowCheckBox_Loaded"
                            Style="{StaticResource CompactCheckBoxStyle}" />

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xEDA2;" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Mountpoint}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind DisplayLabel}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Driver}" />
                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind SizeDisplay}" />

                        <Button
                            Grid.Column="5"
                            Click="RemoveVolume_Click"
                            Tag="{x:Bind Name}"
                            ToolTipService.ToolTip="删除卷（不可撤销）">
                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            批量操作条：必须声明在 ListView 之后（后声明的孩子既画在上面、也先拿到点击）。
            放在前面时 ListView 会盖住它，把按钮点击全部吃掉——批量条看得见却点不动。
        -->
        <Border
            x:Name="BatchBar"
            Grid.Row="2"
            Height="48"
            Margin="0,0,0,12"
            Padding="16,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Translation="0,0,32"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="BatchSelectionText"
                    VerticalAlignment="Center"
                    FontWeight="Medium"
                    Text="已选 0 项" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="BatchClearSelection_Click">
                        <TextBlock Text="取消选择" />
                    </Button>
                    <Button Click="BatchDelete_Click" ToolTipService.ToolTip="删除所有选中卷（不可撤销）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE74D;" />
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="删除" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslcDesktop.Pages.DistrosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslcDesktop.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 加载条行固定 4px（条本身的高度）：Auto 的话条一隐藏行高归零，表头会向上跳 4px -->
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="WSL 发行版" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="管理本机注册的 Linux 发行版实例（与 wslc 容器会话是两套独立的东西）" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="AddDistro_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="添加发行版" />
                    </StackPanel>
                </Button>
                <Button Click="Diagnose_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                        <TextBlock Text="查看 wsl --status" />
                    </StackPanel>
                </Button>
                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning" />

        <ProgressBar x:Name="LoadingBar" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" />

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE74C;" />
            <TextBlock
                MaxWidth="520"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="本机没有注册任何 WSL 发行版，或 wsl.exe 不可用。容器功能不需要发行版；点右上角「添加发行版」可从安装包导入或从微软清单在线安装。" />
        </StackPanel>

        <ListView
            x:Name="DistrosListView"
            Grid.Row="3"
            ItemContainerStyle="{StaticResource DataRowItemStyle}"
            SelectionMode="None">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <!-- 表头与行两套 Grid 必须同列定义；Auto 列一律钉成固定宽度，见 ImagesPage 的说明 -->
                    <Grid Padding="12,0,12,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="176" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="发行版 / 安装位置" />
                        <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态" />
                        <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WSL 版本" />
                        <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="磁盘占用" />
                        <TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="操作" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DistroModel">
                    <Grid Padding="12,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="176" />
                        </Grid.ColumnDefinitions>

                        <Ellipse
                            Grid.Column="0"
                            Width="10"
                            Height="10"
                            Fill="{x:Bind IsRunning, Converter={StaticResource BoolToStatusBrushConverter}, FallbackValue=Gray}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                <Border
                                    Padding="6,2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind IsDefault}">
                                    <TextBlock FontSize="10" Foreground="White" Text="默认" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind BasePath}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind StateDisplay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind VersionDisplay}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind VhdSizeDisplay}" />

                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                            <Button
                                Click="Start_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="启动发行版"
                                Visibility="{x:Bind IsRunning, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}">
                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                            </Button>
                            <Button
                                Click="Terminate_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="终止发行版"
                                Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                <FontIcon FontSize="12" Glyph="&#xE71A;" />
                            </Button>
                            <Button Click="OpenTerminal_Click" Tag="{x:Bind}" ToolTipService.ToolTip="在终端中进入">
                                <FontIcon FontSize="12" Glyph="&#xE756;" />
                            </Button>
                            <!--
                                菜单按"轻 → 重"分段：位置类 / 磁盘类 / 配置类 / 危险操作，
                                分段而不是平铺，是为了让「注销」永远离常用项最远。
                            -->
                            <Button ToolTipService.ToolTip="更多操作">
                                <FontIcon FontSize="12" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="SetDefault_Click" Tag="{x:Bind}" Text="设为默认发行版">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8FB;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OpenLocation_Click" Tag="{x:Bind}" Text="打开安装位置">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSeparator />

                                        <MenuFlyoutItem Click="Compact_Click" Tag="{x:Bind}" Text="压缩磁盘（回收已释放空间）" />
                                        <MenuFlyoutItem Click="Resize_Click" Tag="{x:Bind}" Text="调整磁盘大小…" />
                                        <MenuFlyoutItem Click="Move_Click" Tag="{x:Bind}" Text="移动安装位置…" />
                                        <MenuFlyoutItem Click="Export_Click" Tag="{x:Bind}" Text="导出为 tar 归档…" />
                                        <MenuFlyoutItem Click="EnableSparse_Click" Tag="{x:Bind}" Text="开启稀疏盘（自动回收空间）" />
                                        <MenuFlyoutItem Click="DisableSparse_Click" Tag="{x:Bind}" Text="关闭稀疏盘" />

                                        <MenuFlyoutSeparator />

                                        <MenuFlyoutItem Click="EditWslConf_Click" Tag="{x:Bind}" Text="编辑 /etc/wsl.conf…" />
                                        <MenuFlyoutItem Click="SetDefaultUser_Click" Tag="{x:Bind}" Text="设置默认用户…" />

                                        <MenuFlyoutSeparator />

                                        <MenuFlyoutItem Click="Unregister_Click" Tag="{x:Bind}" Text="注销（删除发行版）">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            长操作（移动 / 导出）就地展示进度与引擎输出，不弹窗打扰。
            与 AddDistroPage 的安装面板同构，只是这里的进度来自"轮询目标文件大小"。
        -->
        <Border
            x:Name="OperationCard"
            Grid.Row="4"
            Padding="14,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="OperationTitleText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="Medium" />
                    <Button
                        x:Name="CancelOperationButton"
                        Grid.Column="1"
                        Padding="10,4"
                        Click="CancelOperation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                            <TextBlock Text="取消" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressBar x:Name="OperationProgressBar" IsIndeterminate="True" />
                <TextBlock
                    x:Name="OperationStatusText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="OperationLogBox"
                    Height="110"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="12"
                    IsReadOnly="True"
                    TextWrapping="NoWrap"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

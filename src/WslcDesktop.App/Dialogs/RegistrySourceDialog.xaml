<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WslcDesktop.Dialogs.RegistrySourceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    mc:Ignorable="d">

    <!--
        宽度不吃 ContentDialog 的 MinWidth/MaxWidth 属性，要盖主题资源键；
        两个键设成同一个值，否则宿主宽度会取"内容期望宽度"→ 弹窗随内容忽宽忽窄。
    -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBox
            x:Name="HostBox"
            Header="镜像源"
            PlaceholderText="例如 ghcr.io 或 harbor.example.com:5000" />

        <TextBox
            x:Name="NoteBox"
            Header="备注"
            MaxLength="200"
            PlaceholderText="例如 公司 Harbor（可选，列表里更好认）" />

        <TextBlock
            x:Name="BuiltInNoteHint"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="内置站点的备注是实测结论，仅供查看。"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <TextBox
            x:Name="UsernameBox"
            Header="用户名"
            PlaceholderText="账号邮箱或用户名；留空表示公开源" />

        <PasswordBox x:Name="PasswordInput" Header="密码 / 访问令牌" />

        <TextBlock
            x:Name="PasswordHint"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <InfoBar
            x:Name="ErrorBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />
    </StackPanel>
</ContentDialog>

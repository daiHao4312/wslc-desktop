<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WslcDesktop.Dialogs.ContainerDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="容器详情"
    CloseButtonText="关闭"
    DefaultButton="Close"
    mc:Ignorable="d">

    <!--
        对话框宽度**不受** ContentDialog 的 MinWidth/MaxWidth 控制：模板里内容宿主的尺寸
        取自主题资源 ContentDialogMinWidth / ContentDialogMaxWidth（默认 320 / 548，
        见 WinUI 通用模板）。不覆盖这两个键，设置属性一律无效——实测内容区恒定 498px，
        三段内容怎么排都会挤。必须在这里覆盖资源键。
    -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">780</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>

    <!--
        根 Grid 的 MinHeight 与三块内容滚动区的 MaxHeight 是一对：
        ContentDialog 测量内容时给的是无限高度，* 行会塌成内容的自然高度，
        ScrollViewer 又会上报"整段 JSON 有多高"→ 切 tab 时对话框高度从 600 跳到 470。
        把滚动区封顶后，两个方向的取值都落在同一个 MinHeight 上，高度就锁死了
        （实测 566 / 560，差 6px）。
    -->
    <Grid RowSpacing="16" MinHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部：身份信息 -->
        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock
                    x:Name="NameText"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold" />
                <Border
                    x:Name="StatePill"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    CornerRadius="4">
                    <TextBlock x:Name="StateText" FontSize="11" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="SummaryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PortsText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar
                x:Name="DialogErrorBar"
                Margin="0,4,0,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </StackPanel>

        <!--
            分段切换用 SelectorBar，不用 Pivot。
            Pivot 的 PivotHeaderItem 默认走 TitleTextBlockStyle（字号 24、内边距大），
            在对话框里既显笨重，选中态的下划线也和 Fluent 主题脱节；
            SelectorBar 是 WinUI 原生分段控件，高度约 40、字号 14，
            与 NavigationView / Mica 同一套视觉语言。

            三块 Pane 叠在同一个 * 行里靠 Visibility 切换，而不是用 Frame 或懒加载：
            这样切页时既不重建视觉树，高度也不跳。
        -->
        <SelectorBar
            x:Name="DetailSelector"
            Grid.Row="1"
            SelectionChanged="DetailSelector_SelectionChanged">
            <SelectorBarItem x:Name="InspectTab" Text="inspect" />
            <SelectorBarItem x:Name="LogTab" Text="日志" />
            <SelectorBarItem x:Name="ExecTab" Text="执行命令" />
        </SelectorBar>

        <!-- 检查 -->
        <Grid x:Name="InspectPane" Grid.Row="2" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Button Click="LoadInspect_Click" Content="刷新 inspect" />
                <Button Click="CopyInspect_Click" Content="复制 JSON" />
            </StackPanel>
            <Border
                Grid.Row="1"
                MaxHeight="370"
                Padding="10,8"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ScrollViewer
                    x:Name="InspectScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="InspectText"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        Text="正在读取…"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 日志 -->
        <Grid
            x:Name="LogPane"
            Grid.Row="2"
            RowSpacing="10"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="LogTailCombo" Width="130" SelectedIndex="2" SelectionChanged="LogTail_Changed">
                    <ComboBoxItem Content="最近 50 行" Tag="50" />
                    <ComboBoxItem Content="最近 100 行" Tag="100" />
                    <ComboBoxItem Content="最近 200 行" Tag="200" />
                    <ComboBoxItem Content="最近 500 行" Tag="500" />
                </ComboBox>
                <Button Click="ReloadLogs_Click" Content="重新读取" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="需要实时跟随（logs -f）请用下方“跟随日志”。" />
            </StackPanel>
            <Border
                Grid.Row="1"
                MaxHeight="370"
                Padding="10,8"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ScrollViewer
                    x:Name="LogScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="LogText"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 执行命令 -->
        <Grid
            x:Name="ExecPane"
            Grid.Row="2"
            RowSpacing="10"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="CommandBox"
                        Grid.Column="0"
                        PlaceholderText="例如：ls -la /  或  cat /etc/os-release"
                        KeyDown="CommandBox_KeyDown" />
                    <Button
                        x:Name="RunCommandButton"
                        Grid.Column="1"
                        Click="RunCommand_Click"
                        Content="执行"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="一次性命令（非交互）。需要 vi / top 这类交互程序时，请用「在终端中打开」。"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Border
                Grid.Row="1"
                MaxHeight="370"
                Padding="10,8"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="CommandOutputText"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        Text="（尚未执行命令，输出会显示在这里）"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>

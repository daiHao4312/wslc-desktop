<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WslcDesktop</RootNamespace>
    <!--
      AssemblyName 必须显式声明为仓库名：默认取项目文件名会产出 WslcDesktop.App.exe，
      和 GitHub 仓库（wslc-desktop）对不上。连字符在程序集名里合法，
      产品名 / exe 名 / 关于页 / 更新检查 UA 因此完全一致。
    -->
    <AssemblyName>wslc-desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsSdkPackageVersion>10.0.26100.80</WindowsSdkPackageVersion>

    <!--
      版本与文件属性单一来源（M12）：
      以前 About 页把 "版本 1.0.0" 写死在 XAML 里，exe 属性又显示成原始程序集名
      （FileDescription = WslcDesktop.App）。现在统一在这里定义，运行时由 AppInfo 读取。
      改版本只改 <Version> 一处：FileVersion / ProductVersion / 关于页 一起变。
    -->
    <Version>2.0.1</Version>
    <AssemblyTitle>wslc-desktop</AssemblyTitle>
    <Product>wslc-desktop</Product>
    <Description>WSL 容器（wslc）原生桌面管理面板</Description>
    <Company>wslc-desktop</Company>
    <Copyright>Copyright © 2026</Copyright>

    <!--
      自包含部署（对应开发文档 §4.4：非 MSIX 单文件、离线可用、双击即用）：
      Windows App SDK 运行时随应用一起分发，目标机器无需预装 WindowsAppRuntime，
      否则非打包应用启动会以 REGDB_E_CLASSNOTREG 直接崩掉。

      WindowsPackageType=None 是本项目**分发形态的声明**：非打包（unpackaged）应用。
      Windows App SDK 的 SingleFile 目标会检查它，缺失时直接报
      "PublishSingleFile only supports unpackaged apps"。
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\AppIcon-256.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WslcDesktop.Core\WslcDesktop.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    发布形态（M12）：自包含 + 单文件。

    * PublishTrimmed 必须**关掉**：WinUI 3 的类型解析走 XAML/反射路径，不受裁剪器保护，
      裁完窗口直接起不来（编译期不报错，属于最坏的失败形态）。体积靠单文件压缩换，
      不靠裁剪。
    * IncludeNativeLibrariesForSelfExtract：Windows App SDK 的原生 dll 进不了单文件本体，
      需要随 exe 自解压到临时目录（首次启动多花一次解压时间，换取"一个文件双击即用"）。
    * EnableCompressionInSingleFile：压缩单文件内容，体积明显下降，代价是首启动解压更久。
    * SatelliteResourceLanguages 限制到 zh-Hans：界面只有中文，砍掉其余语言的资源子目录。
    * PublishReadyToRun=**关**：实测开 R2R 单文件 111MB / 二次启动 0.74s，
      关掉后 96MB / 0.90s——多 21MB 只换 160ms，"收体积"这笔账不划算。
      首次启动两者都是 ~3.2s（单文件自解压到临时目录占了绝大部分），R2R 也救不回来。
  -->
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>

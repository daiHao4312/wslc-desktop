<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WSLC_Panel_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WSLC_Panel_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WSLC 面板"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        KeyboardAcceleratorPlacementMode="Hidden"：关掉「加速键提示」气泡。
        根 Grid 持有 F5 / Ctrl+N / Ctrl+R / Ctrl+1..8 这些加速键，而 WinUI 默认
        （Auto）会在**聚焦、长按、悬停**三种情况下把加速键当 tooltip 弹出来——
        于是鼠标在面板任意位置长按都会冒一个只有「F5」字样的小气泡。
        Hidden 只影响提示的展示，快捷键本身照旧可用。
    -->
    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="WSLC 面板"
            BackRequested="TitleBar_BackRequested"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- 引擎状态横幅：不可用时全页面可见（错误可见纪律，§7.3-5） -->
        <InfoBar
            x:Name="EngineInfoBar"
            Grid.Row="1"
            Margin="24,8,24,0"
            IsOpen="False"
            IsClosable="False"
            Severity="Warning" />

        <!-- 主导航 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="概览"
                    IsSelected="True"
                    Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="容器"
                    Tag="containers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="镜像"
                    Tag="images">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="网络"
                    Tag="networks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="数据卷"
                    Tag="volumes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="会话"
                    Tag="sessions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="WSL 发行版"
                    Tag="distros">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="活动"
                    Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="关于"
                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="NavFrame" />
        </NavigationView>

        <!-- 底部状态栏 -->
        <Border
            Grid.Row="3"
            Padding="16,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WSL 引擎:" />
                        <TextBlock x:Name="StatusWslVersionText" FontSize="12" FontWeight="Medium" Text="检测中…" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="活动会话:" />
                        <TextBlock x:Name="StatusSessionText" FontSize="12" FontWeight="Medium" Text="—" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="刷新:" />
                        <TextBlock x:Name="StatusRefreshModeText" FontSize="12" FontWeight="Medium" Text="检测中…" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="最后事件:" />
                        <TextBlock
                            x:Name="StatusEventText"
                            MaxWidth="420"
                            FontSize="12"
                            Text="—"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="StatusLastUpdateText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="—" />
                    <Button
                        x:Name="GlobalRefreshButton"
                        Padding="8,2"
                        ToolTipService.ToolTip="刷新当前页 (F5)"
                        Click="GlobalRefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            <TextBlock FontSize="12" Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>

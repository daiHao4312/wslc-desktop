<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLC_Panel_App.Pages.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WSLC.Panel.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题与操作栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="容器" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="管理 WSL 容器实例、生命周期与实时资源" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="CreateContainer_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="新建容器" />
                    </StackPanel>
                </Button>
                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 错误横幅 -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="ErrorInfoBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
            <InfoBar
                x:Name="BatchResultInfoBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Success" />
        </StackPanel>

        <!-- 加载进度条 -->
        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="2"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <!-- 空态 -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xEA86;" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="还没有容器。点右上角「新建容器」，或先在镜像页拉取一个镜像。" />
        </StackPanel>

        <!--
            容器列表。
            表头与行必须用**完全相同的列定义**才可能对齐（两套 Grid 各自独立测量）：
            凡「表头文字宽度 ≠ 行内容宽度」的列都不能用 Auto，否则两套 Grid 会算出不同列宽。
            所以「操作」列两侧都写死 176（够放 4 个图标按钮）。

            ItemContainerStyle 把 ListViewItem 自带内边距清零——那圈内边距只作用于行、
            不作用于表头，是"表头与内容错位、内容偏右"的根因。
        -->
        <ListView
            x:Name="ContainersListView"
            Grid.Row="2"
            Padding="0,0,0,64"
            IsMultiSelectCheckBoxEnabled="False"
            ItemContainerStyle="{StaticResource DataRowItemStyle}"
            SelectionChanged="ContainersListView_SelectionChanged"
            SelectionMode="Multiple">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="44,0,12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="176" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态" />
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="名称 / ID" />
                        <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="镜像 / 运行时长" />
                        <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="端口" />
                        <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU" />
                        <TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="内存" />
                        <TextBlock Grid.Column="6" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="操作" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ContainerModel">
                    <Grid>
                        <!--
                            勾选框只能放在这里：ListViewItemPresenter 必须是行模板的根元素
                            （旁边加兄弟元素会直接抛 "can only be used as the first child..."），
                            所以没法在行容器模板里换掉那个尺寸写死的大号多选框。
                            行内容自己在左边留 44px 给它让位。
                        -->
                        <CheckBox
                            x:Name="RowCheckBox"
                            Margin="14,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="RowCheckBox_Click"
                            Loaded="RowCheckBox_Loaded"
                            Style="{StaticResource CompactCheckBoxStyle}" />

                        <Grid Padding="44,8,12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="176" />
                            </Grid.ColumnDefinitions>

                            <!-- 状态 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="{x:Bind IsRunning, Converter={StaticResource BoolToStatusBrushConverter}, FallbackValue=Gray}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind StateDisplay}" />
                            </StackPanel>

                            <!-- 名称与 ID -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ShortId}" />
                            </StackPanel>

                            <!-- 镜像与运行时长 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Image}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind UptimeDisplay}" />
                            </StackPanel>

                            <!-- 端口（带 IP，可点击用浏览器打开） -->
                            <Button
                                Grid.Column="3"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OpenPort_Click"
                                MinWidth="0"
                                Tag="{x:Bind PrimaryBrowserUrl}"
                                ToolTipService.ToolTip="{x:Bind PortsDisplay}"
                                Visibility="{x:Bind HasBrowsablePort, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind PortsDisplay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind PortsDisplay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind HasBrowsablePort, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                            <!-- 实时资源 -->
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind CpuDisplay}" />
                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind MemoryDisplay}" TextTrimming="CharacterEllipsis" />

                            <!-- 操作：高频在行内，危险动作收进「更多」 -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                                <Button
                                    Click="Start_Click"
                                    Tag="{x:Bind Id}"
                                    ToolTipService.ToolTip="启动容器"
                                    Visibility="{x:Bind IsRunning, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}">
                                    <FontIcon FontSize="12" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    Click="Stop_Click"
                                    Tag="{x:Bind Id}"
                                    ToolTipService.ToolTip="停止容器"
                                    Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <FontIcon FontSize="12" Glyph="&#xE71A;" />
                                </Button>
                                <Button Click="Details_Click" Tag="{x:Bind Id}" ToolTipService.ToolTip="查看详情（inspect / 日志 / 执行命令）">
                                    <FontIcon FontSize="12" Glyph="&#xE946;" />
                                </Button>
                                <Button ToolTipService.ToolTip="更多操作">
                                    <FontIcon FontSize="12" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="Restart_Click" Tag="{x:Bind Id}" Text="重启容器">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE72C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="Kill_Click" Tag="{x:Bind Id}" Text="强制终止">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE71A;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="Terminal_Click" Tag="{x:Bind Id}" Text="在终端中打开 shell">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE756;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="CopyId_Click" Tag="{x:Bind Id}" Text="复制容器 ID">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="Delete_Click" Tag="{x:Bind Name}" Text="删除容器">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            批量操作条：浮在列表底部，不占布局行，出现/消失不会把列表整体顶下去。

            必须声明在 ListView **之后**：同一 Grid 行里后声明的孩子既画在上面、
            也先拿到点击。放在前面时 ListView 会盖住它、把按钮的点击全部吃掉
            （实测症状：批量条看得见但所有按钮点不动）。Translation 的 z 只影响绘制顺序，
            不影响命中测试顺序，所以光靠 Translation 抬不起来。
        -->
        <Border
            x:Name="BatchBar"
            Grid.Row="2"
            Height="48"
            Margin="0,0,0,12"
            Padding="16,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Translation="0,0,32"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="BatchSelectionText"
                    VerticalAlignment="Center"
                    FontWeight="Medium"
                    Text="已选 0 项" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="BatchStart_Click" ToolTipService.ToolTip="启动所有选中容器">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE768;" />
                            <TextBlock Text="启动" />
                        </StackPanel>
                    </Button>
                    <Button Click="BatchStop_Click" ToolTipService.ToolTip="停止所有选中容器">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE71A;" />
                            <TextBlock Text="停止" />
                        </StackPanel>
                    </Button>
                    <Button Click="BatchRestart_Click" ToolTipService.ToolTip="重启所有选中容器">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            <TextBlock Text="重启" />
                        </StackPanel>
                    </Button>
                    <Button Click="BatchClearSelection_Click">
                        <TextBlock Text="取消选择" />
                    </Button>
                    <Button Click="BatchDelete_Click" ToolTipService.ToolTip="删除所有选中容器（不可撤销）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE74D;" />
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="删除" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

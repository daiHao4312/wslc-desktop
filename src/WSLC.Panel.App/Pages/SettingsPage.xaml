<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLC_Panel_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!--
            纯列表卡片的上下内边距交给行自己的 0,14，卡片只留 2：
            否则会出现 16(卡) + 14(行) = 30 的双层内边距，首行离卡边明显比左右远。
        -->
        <Style x:Key="SettingsListCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
            <Setter Property="Padding" Value="16,2" />
        </Style>

        <!--
            设置项的分隔用「上边框」而不是独立的分隔元素：
            独立分隔元素会和 StackPanel.Spacing 叠加，间距要么过大要么得靠魔法 Margin 凑。
            首行用 SettingsRowFirstStyle 把边框去掉，四条边就都干净了。
        -->
        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style x:Key="SettingsRowFirstStyle" TargetType="Border" BasedOn="{StaticResource SettingsRowStyle}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 风险提示走主题资源，不再硬编码 OrangeRed（深浅主题下对比度都不受控） -->
        <Style x:Key="RiskyHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="160" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="220" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--
            ToggleSwitch 默认带 On/Off 文案，模板为容纳它预留了 MinWidth（约 154），
            中文环境下就是每行右侧多出一个「开」字 + 一大段空白。
            设置项列表里开关的状态由滑块本身表达，文案清掉并把 MinWidth 归零。
        -->
        <Style x:Key="RowToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                保存反馈放在标题正下方：原来在最底部，改上面几项偏好时根本看不到确认。
            -->
            <StackPanel Grid.Row="0" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="面板外观与偏好；下方直接读写 wslc 引擎自己的 settings.yaml" />
                </StackPanel>
                <InfoBar x:Name="SavedInfoBar" IsClosable="True" IsOpen="False" Severity="Success" Message="设置已保存" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="16">
                <!-- 外观主题 -->
                <Border Style="{StaticResource SettingsListCardStyle}">
                    <Border Style="{StaticResource SettingsRowFirstStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="应用主题" />
                                <TextBlock Style="{StaticResource RowHintStyle}" Text="选择面板的显示外观，即时生效并写入面板自己的偏好文件" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemeComboBox"
                                Grid.Column="1"
                                Style="{StaticResource RowComboBoxStyle}"
                                SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="Default" />
                                <ComboBoxItem Content="浅色模式" Tag="Light" />
                                <ComboBoxItem Content="深色模式" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </Border>

                <!-- 刷新与偏好 -->
                <Border Style="{StaticResource SettingsListCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsRowFirstStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="自动刷新间隔" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="后台轮询容器状态与实时资源统计的周期" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="RefreshIntervalComboBox"
                                    Grid.Column="1"
                                    Style="{StaticResource RowComboBoxStyle}"
                                    SelectionChanged="RefreshIntervalComboBox_SelectionChanged">
                                    <ComboBoxItem Content="1 秒" Tag="1" />
                                    <ComboBoxItem Content="3 秒 (推荐)" Tag="3" />
                                    <ComboBoxItem Content="5 秒" Tag="5" />
                                    <ComboBoxItem Content="10 秒" Tag="10" />
                                    <ComboBoxItem Content="30 秒" Tag="30" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="自动刷新" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="关闭后仅在你点刷新（或按 F5）时更新数据" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoRefreshToggle"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}"
                                    Toggled="AutoRefreshToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="引擎事件流（操作后即时刷新）" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="订阅 wslc events：启停容器等操作一到就刷新，不必等轮询。开启时上面的轮询降级为兜底（不低于 30 秒）；关闭则完全按上面的周期轮询。" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="EventStreamToggle"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}"
                                    Toggled="EventStreamToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="关闭到托盘" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="点关闭按钮时收进托盘继续在后台跑（事件流保持连接）；右键托盘图标可退出。关闭此项则点关闭即退出。" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="CloseToTrayToggle"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}"
                                    Toggled="CloseToTrayToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="默认 Registry 镜像源" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="拉取镜像时未写域名前缀时使用的 Registry（直连 docker.io 在国内常超时）" />
                                </StackPanel>
                                <TextBox
                                    x:Name="RegistryTextBox"
                                    Grid.Column="1"
                                    Style="{StaticResource RowTextBoxStyle}"
                                    LostFocus="RegistryTextBox_LostFocus" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 引擎配置 settings.yaml -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="wslc 引擎配置（settings.yaml）" />
                                    <TextBlock
                                        x:Name="EngineConfigPathText"
                                        Style="{StaticResource RowHintStyle}"
                                        Text="—"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Click="ReloadEngineConfig_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                            <TextBlock Text="重新加载" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ShowBackups_Click" ToolTipService.ToolTip="查看历史备份文件">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE81C;" />
                                            <TextBlock Text="备份记录" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                        </Grid>

                        <InfoBar
                            x:Name="EngineInfoBar"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Success" />

                        <!--
                            「表单模式 / 原始 YAML」用 SelectorBar，不用 Pivot：
                            PivotHeaderItem 默认 TitleTextBlockStyle（字号 24、内边距大），
                            嵌在卡片里像另一个层级的标题，也和 Fluent 主题脱节。
                        -->
                        <SelectorBar x:Name="EngineConfigSelector" SelectionChanged="EngineConfigSelector_SelectionChanged">
                            <SelectorBarItem x:Name="FormModeTab" Text="表单模式" />
                            <SelectorBarItem x:Name="RawYamlTab" Text="原始 YAML" />
                        </SelectorBar>

                        <!-- 表单模式 -->
                        <StackPanel x:Name="FormModePane" Spacing="4">
                            <TextBlock
                                Style="{StaticResource RowHintStyle}"
                                Text="留空表示恢复为 default（该行会被重新注释掉）。保存时只改动你填写的键，文件里的注释与排版原样保留。" />

                            <StackPanel x:Name="FormFieldsPanel" Spacing="0" />

                            <Button
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Click="SaveForm_Click"
                                Content="保存到 settings.yaml"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>

                        <!-- 原始 YAML -->
                        <StackPanel
                            x:Name="RawYamlPane"
                            Spacing="12"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{StaticResource RowHintStyle}"
                                Text="直接编辑引擎配置文件。保存前会自动生成时间戳备份；写坏的配置可能导致容器引擎无法启动。" />

                            <TextBox
                                x:Name="RawYamlBox"
                                MinHeight="320"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                FontSize="12"
                                IsSpellCheckEnabled="False"
                                TextWrapping="NoWrap" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="SaveRaw_Click"
                                    Content="保存并备份"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button Click="ReloadEngineConfig_Click" Content="放弃改动并重新加载" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLC_Panel_App.Pages.DistrosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WSLC.Panel.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="WSL 发行版" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="管理本机注册的 Linux 发行版实例（与 wslc 容器会话是两套独立的东西）" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="Diagnose_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                        <TextBlock Text="查看 wsl --status" />
                    </StackPanel>
                </Button>
                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning" />

        <ProgressBar x:Name="LoadingBar" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" />

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE74C;" />
            <TextBlock
                MaxWidth="520"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="本机没有注册任何 WSL 发行版，或 wsl.exe 不可用。容器功能不需要发行版；如需发行版，可在管理员终端执行 wsl --install -d Ubuntu。" />
        </StackPanel>

        <ListView
            x:Name="DistrosListView"
            Grid.Row="3"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DistroModel">
                    <Grid Padding="12,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse
                            Grid.Column="0"
                            Width="10"
                            Height="10"
                            Fill="{x:Bind IsRunning, Converter={StaticResource BoolToStatusBrushConverter}, FallbackValue=Gray}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                <Border
                                    Padding="6,2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind IsDefault}">
                                    <TextBlock FontSize="10" Foreground="White" Text="默认" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind BasePath}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind StateDisplay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind VersionDisplay}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind VhdSizeDisplay}" />

                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                            <Button
                                Click="Start_Click"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="启动发行版"
                                Visibility="{x:Bind IsRunning, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}">
                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                            </Button>
                            <Button
                                Click="Terminate_Click"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="终止发行版"
                                Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                <FontIcon FontSize="12" Glyph="&#xE71A;" />
                            </Button>
                            <Button Click="OpenTerminal_Click" Tag="{x:Bind Name}" ToolTipService.ToolTip="在终端中进入">
                                <FontIcon FontSize="12" Glyph="&#xE756;" />
                            </Button>
                            <Button ToolTipService.ToolTip="更多操作">
                                <FontIcon FontSize="12" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="SetDefault_Click" Tag="{x:Bind Name}" Text="设为默认发行版">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8FB;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Click="Unregister_Click" Tag="{x:Bind Name}" Text="注销（删除发行版）">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

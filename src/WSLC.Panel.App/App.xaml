<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WSLC_Panel_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WSLC_Panel_App"
    xmlns:converters="using:WSLC_Panel_App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                中文界面统一用 YaHei UI。默认的 Segoe UI Variable 在中文回退下字面偏细，
                小字号看起来发飘、缺层次。
            -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
            <converters:EventSeverityBrushConverter x:Key="EventSeverityBrushConverter" />

            <!-- ============================================================
                 紧凑勾选框
                 ListView 自带的多选框由 ListViewItemPresenter 原生自绘，尺寸写死在
                 呈现器里、没有任何可调属性（已实测确认），所以批量列表改为自绘。
                 ============================================================ -->
            <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid
                                x:Name="CheckRoot"
                                Width="16"
                                Height="16"
                                Background="Transparent">
                                <Border
                                    x:Name="Box"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <FontIcon
                                    x:Name="CheckGlyph"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE73E;"
                                    Visibility="Collapsed" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CombinedStates">
                                        <VisualState x:Name="UncheckedNormal" />
                                        <VisualState x:Name="UncheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="UncheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="UncheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="CheckRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="CheckedNormal">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                                <Setter Target="CheckRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="IndeterminateNormal">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="CheckGlyph.Glyph" Value="&#xE738;" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                <Setter Target="CheckGlyph.Glyph" Value="&#xE738;" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePressed">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                <Setter Target="Box.BorderBrush" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                <Setter Target="CheckGlyph.Glyph" Value="&#xE738;" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminateDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="CheckRoot.Opacity" Value="0.4" />
                                                <Setter Target="CheckGlyph.Glyph" Value="&#xE738;" />
                                                <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                数据行容器：把 ListViewItem 自带的内边距全部清零。

                为什么必须清零：ListViewItem 默认样式通过
                ContentMargin={TemplateBinding Padding} 给行内容留了一圈内边距，
                而列表表头（ListView.HeaderTemplate）是另一套容器、没有这圈内边距——
                于是表头文字与行内容整体错位（实测行内容右移 16px），
                且行内可用宽度比表头小，右侧几列越往右偏得越多。
                清零后表头与行都用「同一个 Grid + 同一套列定义」，列才真正对得上。
            -->
            <Style x:Key="DataRowItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!--
                注意：这里**不能**用自定义 ItemContainerStyle 换掉多选框。
                ListViewItemPresenter 必须是 ListViewItem 模板的根元素本身，一旦旁边再放
                兄弟元素，布局期直接抛
                "ListViewItemPresenter can only be used as the first child in the template for a ListViewItem"
                （已实测两次）。所以批量列表的做法是：ListView 关掉自带多选框
                （IsMultiSelectCheckBoxEnabled="False"），再把 CompactCheckBoxStyle 放进各页的 ItemTemplate。
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
